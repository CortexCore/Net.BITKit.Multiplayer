<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>BITKit.Multiplayer.Samples.Arena.Game</AssemblyName></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Projects/BITKit.Multiplayer.csproj" />
    <ProjectReference Include="../../../Projects/BITKit.Multiplayer.TouchSocket.csproj" />
    <ProjectReference Include="../../../Projects/BITKit.Multiplayer.Transport.csproj" />
    <ProjectReference Include="../Contracts/Arena.Contracts.csproj" />
    <ProjectReference Include="../../../CodeGen/BITKit.Multiplayer.CodeGen.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="WeaveArenaGame" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(IntermediateOutputPath)$(AssemblyName).dll" DestinationFiles="$(TargetDir)$(AssemblyName).unwoven.dll" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\..\..\Artifacts\bin\BITKit.Multiplayer.CodeGen\$(Configuration)\net10.0\Net.BITKit.Multiplayer.CodeGen.dll&quot; &quot;$(TargetDir)$(AssemblyName).unwoven.dll&quot; &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
