config_version=5

[application]
config/name="BITKit Dynamic Network Objects"
run/main_scene="res://ObjectLab.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]
window/size/viewport_width=1000
window/size/viewport_height=650
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="NetworkObjectsGodot"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)
