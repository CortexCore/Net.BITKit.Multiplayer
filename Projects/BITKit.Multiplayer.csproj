<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Net.BITKit.Multiplayer</AssemblyName>
    <RootNamespace>BITKit.Multiplayer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><Compile Include="../Src/Runtime/**/*.cs" /><ProjectReference Include="BITKit.Multiplayer.Contracts.csproj" /><PackageReference Include="MemoryPack.Core" Version="1.21.4" /><PackageReference Include="MessagePack" Version="3.1.8" /><PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" /></ItemGroup>
  <ItemGroup><PackageReference Include="UniTask" Version="2.5.10" /></ItemGroup>
</Project>
