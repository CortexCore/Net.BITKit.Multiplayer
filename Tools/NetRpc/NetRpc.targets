<Project>
  <PropertyGroup>
    <NetRpcCodeGen Condition="'$(NetRpcCodeGen)' == ''">$(MSBuildThisFileDirectory)../../Artifacts/bin/BITKit.Multiplayer.CodeGen/$(Configuration)/net10.0/Net.BITKit.Multiplayer.CodeGen.dll</NetRpcCodeGen>
    <NetRpcGeneratedSource>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/NetRpc.Remote.g.cs</NetRpcGeneratedSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(NetRpcContractsAssembly)' != ''"><Compile Include="$(NetRpcGeneratedSource)" /></ItemGroup>
  <Target Name="GenerateNetRpcInterfaces" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(NetRpcContractsAssembly)' != ''" Inputs="$(NetRpcContractsAssembly);$(NetRpcCodeGen)" Outputs="$(NetRpcGeneratedSource)">
    <Exec Command="dotnet &quot;$(NetRpcCodeGen)&quot; --remote &quot;$(NetRpcContractsAssembly)&quot; &quot;$(NetRpcGeneratedSource)&quot;" />
  </Target>
  <Target Name="WeaveNetRpcObjects" AfterTargets="Build" Condition="'$(NetRpcWeave)' == 'true'">
    <Exec Command="dotnet &quot;$(NetRpcCodeGen)&quot; &quot;$(IntermediateOutputPath)$(TargetName).dll&quot; &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
